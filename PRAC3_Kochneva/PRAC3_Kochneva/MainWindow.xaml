<Window x:Class="PRAC3_Kochneva.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PRAC3_Kochneva"
        mc:Ignorable="d"
        Title="Pusheen"
        Height="500"
        Width="850"
        Icon="/Resources/иконка.ico"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#FFFFF8FB">

        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Background="#FFFFDCE8">

            <Button x:Name="btnBack"
                    Content="← Назад"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Width="100"
                    Margin="5"
                    Click="btnBack_Click"/>

            <Image Width="48"
                   Height="48"
                   HorizontalAlignment="Left"
                   Margin="12,0,0,0"
                   Source="/Resources/карт.png"/>

            <TextBlock Text="Pusheen"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#684653"
                       Margin="0"/>

        </Grid>

        <Frame x:Name="FrmMain"
               Grid.Row="1"
               NavigationUIVisibility="Hidden"
               ContentRendered="FrmMain_ContentRendered"/>

    </Grid>

</Window>